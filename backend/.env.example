# Copy this file to `.env` and fill in your Supabase project's connection details.
# Find these under: Supabase Dashboard > Project Settings > Database > Connection Info.
# Never commit the real .env -- .gitignore it.

DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your-supabase-db-password
DB_HOST=db.your-project-ref.supabase.co
DB_PORT=5432
